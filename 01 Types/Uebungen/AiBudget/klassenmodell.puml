@startuml
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 15
skinparam ArrowThickness 1.5
skinparam ArrowColor #1d1d1b
skinparam class {
  BackgroundColor #ffffff
  HeaderBackgroundColor #ededed
  BorderColor #1d1d1b
  BorderThickness 1.5
  FontStyle bold
}
skinparam stereotypeCBackgroundColor #d1ebf7
skinparam stereotypeABackgroundColor #fdebd1
skinparam stereotypeIBackgroundColor #e5f4f1
skinparam stereotypeEBackgroundColor #e5f1d9
skinparam nodesep 12
skinparam ranksep 40
hide empty fields
hide empty methods

abstract class AiRequest
{
    +ModelName : string
    +Project : string
    +{abstract} Cost : decimal
    ---
    #AiRequest(string modelName,
<U+00A0><U+00A0><U+00A0><U+00A0>string project)
    +override string ToString()
}

class ChatRequest
{
    +InputTokens : int
    +OutputTokens : int
    +Cost : decimal
    ---
    +ChatRequest(string modelName,
<U+00A0><U+00A0><U+00A0><U+00A0>string project, int inputTokens,
<U+00A0><U+00A0><U+00A0><U+00A0>int outputTokens)
    +override string ToString()
}

class ImageRequest
{
    +Images : int
    +IsHighResolution : bool
    +Cost : decimal
    ---
    +ImageRequest(string modelName,
<U+00A0><U+00A0><U+00A0><U+00A0>string project, int images,
<U+00A0><U+00A0><U+00A0><U+00A0>bool isHighResolution)
}

interface IBudgetRule
{
    +Name : string
    ---
    +bool Allows(AiRequest request,
<U+00A0><U+00A0><U+00A0><U+00A0>decimal spent)
}

class MonthlyLimitRule
{
    +Limit : decimal
    ---
    +MonthlyLimitRule(decimal limit)
}

class MaxRequestCostRule
{
    +MaxCost : decimal
    ---
    +MaxRequestCostRule(
<U+00A0><U+00A0><U+00A0><U+00A0>decimal maxCost)
}

class NoImagesRule

class BudgetAccount
{
    +Owner : string
    +Rules : IReadOnlyList<IBudgetRule>
    +Requests : IReadOnlyList<AiRequest>
    +UsedModels : IReadOnlySet<string>
    +CostPerProject :
<U+00A0><U+00A0><U+00A0><U+00A0>IReadOnlyDictionary<string, decimal>
    +Spent : decimal
    ---
    +BudgetAccount(string owner)
    +void AddRule(IBudgetRule rule)
    +string? FirstBlockingRule(
<U+00A0><U+00A0><U+00A0><U+00A0>AiRequest request)
    +bool Submit(AiRequest request)
}

BudgetAccount "1" --> "*" AiRequest
BudgetAccount "*" --> "*" IBudgetRule
IBudgetRule .left.> AiRequest
ChatRequest -up-|> AiRequest
ImageRequest -up-|> AiRequest
MonthlyLimitRule .up.|> IBudgetRule
MaxRequestCostRule .up.|> IBudgetRule
NoImagesRule .up.|> IBudgetRule
ChatRequest -[hidden]down- MonthlyLimitRule
ImageRequest -[hidden]down- MaxRequestCostRule
@enduml
