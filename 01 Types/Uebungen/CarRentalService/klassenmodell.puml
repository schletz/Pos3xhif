@startuml
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 15
skinparam ArrowThickness 1.5
skinparam class {
  BackgroundColor #ffffff
  HeaderBackgroundColor #ededed
  BorderColor #1d1d1b
  BorderThickness 1.5
  FontStyle bold
}
skinparam stereotypeCBackgroundColor #d1ebf7
skinparam stereotypeABackgroundColor #fdebd1
skinparam stereotypeIBackgroundColor #e5f4f1
skinparam stereotypeEBackgroundColor #e5f1d9
hide empty fields
hide empty methods

abstract class Vehicle
{
    +LicencePlate : string
    +PricePerDay : decimal
    +Power : int
    +{abstract} RequiredDrivingLicence : string
    ---
    #Vehicle(string licencePlate, decimal pricePerDay, int power)
    +{abstract} decimal CalculatePrice(int days, int kilometers)
}

class Motorcycle
{
    +RequiredDrivingLicence : string
    ---
    +Motorcycle(string licencePlate, decimal pricePerDay, int power)
    +decimal CalculatePrice(int days, int kilometers)
}
Motorcycle -up-|> Vehicle

class Car
{
    +PricePerKm : decimal
    +Weight : int
    +RequiredDrivingLicence : string
    ---
    +Car(string licencePlate, decimal pricePerDay, int power, decimal pricePerKm, int weight)
    +decimal CalculatePrice(int days, int kilometers)
}
Car -up-|> Vehicle

class Customer
{
    +Firstname : string
    +Lastname : string
    ---
    +Customer(string firstname, string lastname)
}

class Rental
{
    +Start : DateTime
    +End : DateTime?
    +Customer : Customer
    +Vehicle : Vehicle
    +KilometersBegin : int
    +KilometersEnd : int?
    +RentedDays : int?
    ---
    +Rental(DateTime start, Customer customer, Vehicle vehicle, int kilometersBegin)
    +decimal CalculatePrice()
}
Rental "*" --> "1" Customer
Rental "*" --> "1" Vehicle
@enduml
