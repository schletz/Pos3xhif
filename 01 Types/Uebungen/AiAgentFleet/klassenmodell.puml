@startuml
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 15
skinparam ArrowThickness 1.5
skinparam ArrowColor #1d1d1b
skinparam class {
  BackgroundColor #ffffff
  HeaderBackgroundColor #ededed
  BorderColor #1d1d1b
  BorderThickness 1.5
  FontStyle bold
}
skinparam stereotypeCBackgroundColor #d1ebf7
skinparam stereotypeABackgroundColor #fdebd1
skinparam stereotypeIBackgroundColor #e5f4f1
skinparam stereotypeEBackgroundColor #e5f1d9
skinparam nodesep 12
skinparam ranksep 40
hide empty fields
hide empty methods

abstract class AiAgent
{
    +Name : string
    +Team : string
    +{abstract} CostPerRun : decimal
    ---
    #AiAgent(string name,
<U+00A0><U+00A0><U+00A0><U+00A0>string team)
    +override string ToString()
}

class ResearchAgent
{
    +Searches : int
    +CostPerRun : decimal
    ---
    +ResearchAgent(string name,
<U+00A0><U+00A0><U+00A0><U+00A0>string team, int searches)
}

class CodingAgent
{
    +Minutes : int
    +CostPerRun : decimal
    ---
    +CodingAgent(string name,
<U+00A0><U+00A0><U+00A0><U+00A0>string team, int minutes)
    +override string ToString()
}

interface IRunPolicy
{
    +Name : string
    ---
    +bool Allows(AiAgent agent,
<U+00A0><U+00A0><U+00A0><U+00A0>int runs)
}

class MaxRunsPolicy
{
    +MaxRuns : int
    ---
    +MaxRunsPolicy(int maxRuns)
}

class MaxCostPolicy
{
    +MaxCost : decimal
    ---
    +MaxCostPolicy(decimal maxCost)
}

class OnlyResearchPolicy

class AgentFleet
{
    +Company : string
    +Policies : IReadOnlyList<IRunPolicy>
    +Agents : IReadOnlyList<AiAgent>
    +Teams : IReadOnlySet<string>
    +RunsPerAgent :
<U+00A0><U+00A0><U+00A0><U+00A0>IReadOnlyDictionary<string, int>
    +TotalCost : decimal
    ---
    +AgentFleet(string company)
    +void AddPolicy(IRunPolicy policy)
    +bool Register(AiAgent agent)
    +string? FirstBlockingPolicy(
<U+00A0><U+00A0><U+00A0><U+00A0>AiAgent agent)
    +bool Run(AiAgent agent)
}

AgentFleet "1" --> "*" AiAgent
AgentFleet "*" --> "*" IRunPolicy
IRunPolicy .left.> AiAgent
ResearchAgent -up-|> AiAgent
CodingAgent -up-|> AiAgent
MaxRunsPolicy .up.|> IRunPolicy
MaxCostPolicy .up.|> IRunPolicy
OnlyResearchPolicy .up.|> IRunPolicy
ResearchAgent -[hidden]down- MaxRunsPolicy
CodingAgent -[hidden]down- MaxCostPolicy
@enduml
