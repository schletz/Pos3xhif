@startuml
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 15
skinparam ArrowThickness 1.5
skinparam class {
  BackgroundColor #ffffff
  HeaderBackgroundColor #ededed
  BorderColor #1d1d1b
  BorderThickness 1.5
  FontStyle bold
}
skinparam stereotypeCBackgroundColor #d1ebf7
skinparam stereotypeABackgroundColor #fdebd1
skinparam stereotypeIBackgroundColor #e5f4f1
skinparam stereotypeEBackgroundColor #e5f1d9
hide empty methods

class Event {
  + Id : int
  + Name : string
  + Shows : List<Show>
}
class Show {
  + Id : int
  + Event : Event
  + Date : DateTime
  + Contingents : List<Contingent>
}
class Contingent {
  + Id : int
  + Show : Show
  + ContingentType : ContingentType
  + AvailableTickets : int
  + Tickets : List<Ticket>
}
class Guest {
  + Id : int
  + Firstname : string
  + Lastname : string
  + BirthDate : DateOnly
  + Tickets : List<Ticket>
}
class Ticket {
  + Id : int
  + Guest : Guest
  + Contingent : Contingent
  + TicketState : TicketState
  + ReservationDateTime : DateTime
  + Pax : int
}
enum ContingentType {
  Floor
  Stands
  Rang
}
enum TicketState {
  Reserved
  Sold
}
Event "1" -- "*" Show
Show "1" -- "*" Contingent
Contingent "1" -- "*" Ticket
Guest "1" -- "*" Ticket
Contingent ..> ContingentType
Ticket ..> TicketState
@enduml
