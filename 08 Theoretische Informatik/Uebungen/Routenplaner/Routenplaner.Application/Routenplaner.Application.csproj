<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The network data is copied to the output folder of every referencing project (e.g. the tests). -->
    <None Update="Data\ubahn_wien.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
