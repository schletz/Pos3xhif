@startuml
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontSize 15
skinparam ArrowThickness 1.5
skinparam class {
  BackgroundColor #ffffff
  HeaderBackgroundColor #ededed
  BorderColor #1d1d1b
  BorderThickness 1.5
  FontStyle bold
}
skinparam stereotypeCBackgroundColor #d1ebf7
skinparam stereotypeABackgroundColor #fdebd1
skinparam stereotypeIBackgroundColor #e5f4f1
skinparam stereotypeEBackgroundColor #e5f1d9
skinparam packageStyle rectangle
skinparam package {
  BorderColor #9d9d9c
  FontStyle bold
}
hide empty members

package "Vorher: 1 Klasse, 4 Gründe für Änderungen" as before {
  class "OrderService" as OldService {
    - orders : List<Order>
    - nextId : int
    + Orders : IReadOnlyList<Order>
    + PlaceOrder(email, lines) : string
    ..
    1. Validierung
    2. Preis und Versand
    3. Speichern
    4. Bestätigungstext
  }
}

package "Nachher: 1 Koordinator + 4 Klassen mit je 1 Grund" as after {
  class OrderService {
    + Orders : IReadOnlyList<Order>
    + PlaceOrder(email, lines) : string
  }
  class OrderValidator {
    + Validate(email, lines) : void
  }
  class PriceCalculator {
    + CalculateTotal(lines) : decimal
  }
  class OrderRepository {
    - orders : List<Order>
    - nextId : int
    + Orders : IReadOnlyList<Order>
    + Add(email, lines, total) : Order
  }
  class ConfirmationFormatter {
    + Format(order : Order) : string
  }
  OrderService --> OrderValidator
  OrderService --> PriceCalculator
  OrderService --> OrderRepository
  OrderService --> ConfirmationFormatter
}

OldService -[hidden]down- OrderService
@enduml
